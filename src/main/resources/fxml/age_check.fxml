<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" fillWidth="false" spacing="25.0" styleClass="setup" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team5.gui.AgeCheckController">
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
      <children>
         <AnchorPane prefHeight="258.0" prefWidth="574.0">
            <children>
               <ImageView fitHeight="228.0" fitWidth="540.0" layoutX="20.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../images/brand/route-beer-text.png" />
                  </image>
                  <viewport>
                     <Rectangle2D />
                  </viewport>
               </ImageView>
            </children>
         </AnchorPane>
      </children>
   </HBox>
   <VBox alignment="CENTER" maxWidth="1.7976931348623157E308" prefWidth="630.0" spacing="10.0" styleClass="age-check-container">
      <children>
         <Label fx:id="infoLabel" styleClass="age-label" text="Are you over 18?" textAlignment="CENTER">
   </Label>
         <HBox fx:id="ageCheckHBox" alignment="CENTER" spacing="15.0">
            <Button mnemonicParsing="false" onAction="#onYesButtonClicked" prefHeight="30.0" prefWidth="150.0" styleClass="login-button" text="Yes" />
            <Button mnemonicParsing="false" onAction="#onNoButtonClicked" prefHeight="30.0" prefWidth="150.0" styleClass="login-button-no" text="No" />
         </HBox>
      </children>
   </VBox>
</VBox>
