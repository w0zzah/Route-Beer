<AnchorPane styleClass="drink-anchor" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team5.gui.AlcoholSafetyPopupLeftController">
