<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="1080.0" prefWidth="1920.0" spacing="50.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team5.gui.entry.DataViewController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" styleClass="h1" stylesheets="@../css/style.css" text="Location Data">
         <font>
            <Font name="Franklin Gothic Medium Italic" size="20.0" />
         </font>
      </Label>
      <TableView fx:id="dataTable" fixedCellSize="50.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <columns>
            <TableColumn fx:id="locID" text="locID" />
          <TableColumn fx:id="name" prefWidth="136.0" text="name" />
            <TableColumn fx:id="description" prefWidth="40.0" text="description" />
            <TableColumn fx:id="latitude" text="latitude" />
            <TableColumn fx:id="longitude" text="longitude" />
            <TableColumn fx:id="address" prefWidth="40.0" text="address" />
            <TableColumn fx:id="features" prefWidth="40.0" text="features" />
            <TableColumn fx:id="openingTime" prefWidth="40.0" text="openingTime" />
            <TableColumn fx:id="closingTime" prefWidth="40.0" text="closingTime" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="randomLocationButton" mnemonicParsing="false" onAction="#showAllBars" styleClass="login-button" text="View Random Location" />
      <Button fx:id="backButton" alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#goBack" styleClass="login-button" text="Back" />
   </children>
   <padding>
      <Insets bottom="50.0" left="200.0" right="200.0" top="50.0" />
   </padding>
</VBox>
